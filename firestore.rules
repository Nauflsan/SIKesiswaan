rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function getRole() {
      return getUserData().role;
    }
    function isAdmin() {
      return isAuth() && getRole() == 'admin';
    }
    function isGuruBK() {
      return isAuth() && (getRole() == 'guru_bk' || getRole() == 'admin');
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuth();
      // Izinkan inisialisasi akun sendiri saat login pertama kali
      allow create: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow update, delete: if isAdmin();
    }

    // 2. Siswa collection
    match /siswa/{siswaId} {
      allow read: if isAuth();
      allow create, update: if isGuruBK();
      allow delete: if isAdmin();
    }

    // 3. Kasus collection
    match /kasus/{kasusId} {
      allow read: if isAuth();
      allow create, update: if isGuruBK();
      allow delete: if isAdmin();
    }

    // 4. Kategori collection
    match /kategori/{kategoriId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // 5. Surat collection
    match /surat/{suratId} {
      allow read: if isAuth();
      allow create, update: if isGuruBK();
      allow delete: if isAdmin();
    }

    // 6. Settings collection (singleton)
    match /settings/{settingId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // 7. Log Aktivitas (Immutable audit trail)
    match /logAktivitas/{logId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
